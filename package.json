{
  "name": "hoodflow",
  "private": true,
  "version": "0.1.0",
  "description": "HOODFLOW — Know Before You Flow. Token intelligence and market-context platform.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @hoodflow/api run dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0"
}
