# Copy to .env for local development. All values are optional — the API
# runs and degrades gracefully (PROVIDER_UNAVAILABLE / DATA_UNAVAILABLE)
# without any of them, per docs/ARCHITECTURE.md's data-integrity rules.

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Free self-service key from dev.blockscout.com — raises the Robinhood Chain
# Blockscout rate limit from unauthenticated (heavily throttled) to 5 req/s.
BLOCKSCOUT_API_KEY=

# Optional GoPlus Bearer token for higher rate limits. Not required at low volume.
GOPLUS_API_KEY=

# X (Twitter) API v2 Bearer token. Required for Social Intelligence — under
# X's current API terms, the recent-search endpoint has no free tier. Left
# unset, XSocialClient reports PROVIDER_UNAVAILABLE without making a network
# call (see docs/SOCIAL_NEWS_INTELLIGENCE.md). GDELT (News Intelligence)
# needs no key at all.
X_BEARER_TOKEN=

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Whether to read the client IP from X-Forwarded-For (which is what the per-IP
# rate limiter buckets on). Only two values are accepted; anything else fails
# startup on purpose.
#
# Leave it false when the API is reached directly. Set it to true ONLY when
# the layer in front of the app overwrites X-Forwarded-For, because otherwise
# a client can forge a new rate-limit bucket on every request. Vercel does
# overwrite it (https://vercel.com/docs/headers/request-headers), so the
# Vercel deployment sets TRUST_PROXY=true; a plain reverse proxy you have not
# checked does not qualify.
#
# The cost of leaving it false behind a proxy is not subtle: every request
# then appears to come from the proxy, so all users share ONE rate-limit
# bucket and one busy client 429s everybody else.
TRUST_PROXY=false

# Durable history (optional). Unset -> InMemoryHistoryStore (lost on every
# restart, single-process only). Set to a real Postgres connection string ->
# PostgresHistoryStore (apps/api/src/history/postgres-history-store.ts),
# which survives restarts and works across multiple API instances sharing
# the same database. Schema is applied automatically and idempotently on
# first use (apps/api/migrations/001_init.sql) — no separate migration step
# to run by hand. See docs/HISTORY_SCHEMA.md for the design rationale.
# Example: postgresql://user:password@host:5432/hoodflow
DATABASE_URL=

# Maximum PostgreSQL connections this process opens. Ignored when DATABASE_URL
# is unset. 10 suits a long-running single-process deploy.
#
# Set it to 1 on serverless. There the platform runs many instances
# concurrently and each one builds its own pool, so 10 per instance becomes
# hundreds of backend connections and exhausts the database's connection
# limit. On a serverless deployment also point DATABASE_URL at the provider's
# *pooler* endpoint rather than the direct-connection one (on Supabase that is
# the "Transaction pooler" / port 6543 URI, not port 5432).
PG_POOL_MAX=10
