# Copy to .env for local development. All values are optional — the API
# runs and degrades gracefully (PROVIDER_UNAVAILABLE / DATA_UNAVAILABLE)
# without any of them, per docs/ARCHITECTURE.md's data-integrity rules.

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Free self-service key from dev.blockscout.com — raises the Robinhood Chain
# Blockscout rate limit from unauthenticated (heavily throttled) to 5 req/s.
BLOCKSCOUT_API_KEY=

# Optional GoPlus Bearer token for higher rate limits. Not required at low volume.
GOPLUS_API_KEY=

# X (Twitter) API v2 Bearer token. Required for Social Intelligence — under
# X's current API terms, the recent-search endpoint has no free tier. Left
# unset, XSocialClient reports PROVIDER_UNAVAILABLE without making a network
# call (see docs/SOCIAL_NEWS_INTELLIGENCE.md). GDELT (News Intelligence)
# needs no key at all.
X_BEARER_TOKEN=

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Durable history (optional). Unset -> InMemoryHistoryStore (lost on every
# restart, single-process only). Set to a real Postgres connection string ->
# PostgresHistoryStore (apps/api/src/history/postgres-history-store.ts),
# which survives restarts and works across multiple API instances sharing
# the same database. Schema is applied automatically and idempotently on
# first use (apps/api/migrations/001_init.sql) — no separate migration step
# to run by hand. See docs/HISTORY_SCHEMA.md for the design rationale.
# Example: postgresql://user:password@host:5432/hoodflow
DATABASE_URL=
