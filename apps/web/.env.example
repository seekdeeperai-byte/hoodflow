# Copy to .env.local for local development. Optional — defaults to
# http://localhost:8787, the same default apps/api listens on.
#
# Only used server-side, inside next.config.mjs's rewrites() (see
# docs/FRONTEND.md "Data flow: API -> UI"). The browser never sees this
# value: it always talks to this Next.js server on a same-origin relative
# path (/api/v1/...), which then forwards the request server-to-server.
# Set this when apps/api is deployed somewhere other than localhost:8787
# (e.g. a separate deployment from apps/web).
HOODFLOW_API_BASE_URL=http://localhost:8787

# --- Technical SEO / indexability (see apps/web/lib/site.ts) -----------------
#
# REQUIRED IN PRODUCTION. The public origin this deployment is served from,
# with no trailing slash (e.g. https://hoodflow.example.com). It is what
# canonical URLs, Open Graph URLs, JSON-LD and sitemap.xml are built from.
#
# Leave it unset and the app still runs completely normally, but it serves
# `noindex` and robots.txt disallows everything. That is deliberate, not a
# bug: without knowing its own origin the app cannot emit a truthful
# canonical URL, and a wrong canonical is worse than no indexing at all. It
# also means a preview/staging deploy that was never given a URL can never
# leak into a search index by accident.
#
# => If production is unexpectedly not being indexed, this is the first
#    variable to check.
HOODFLOW_SITE_URL=

# Set to "true" to force `noindex` even when HOODFLOW_SITE_URL *is* set.
# This is the switch for a staging environment that has its own real domain
# but must stay out of search results. Leave unset/empty in production.
HOODFLOW_NOINDEX=
