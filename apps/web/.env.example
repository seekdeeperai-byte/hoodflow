# Copy to .env.local for local development. Optional — defaults to
# http://localhost:8787, the same default apps/api listens on.
#
# Only used server-side, inside next.config.mjs's rewrites() (see
# docs/FRONTEND.md "Data flow: API -> UI"). The browser never sees this
# value: it always talks to this Next.js server on a same-origin relative
# path (/api/v1/...), which then forwards the request server-to-server.
# Set this when apps/api is deployed somewhere other than localhost:8787
# (e.g. a separate deployment from apps/web).
HOODFLOW_API_BASE_URL=http://localhost:8787
